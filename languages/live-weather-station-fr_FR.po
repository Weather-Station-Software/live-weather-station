#. translators: %s: Name of the plugin.
#: includes/system/InlineHelp.php:1243
#, php-format
msgid "An error that undoubtedly affects the %s system operations."
msgstr "Une erreur qui affecte de façon certaine le fonctionnement système de %s."

#. translators: %s: Name of the plugin.
