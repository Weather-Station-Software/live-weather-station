<?xml version="1.0"?>
<ruleset name="Weather Station PHP compatibility">
    <description>PHP compatibility check of the plugin and its bundled libraries. The PHP version range is passed by the CI (testVersion).</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.claude/*</exclude-pattern>

    <rule ref="PHPCompatibility">
        <!-- False positives: methods named mysql_*() (EnvManager::mysql_version_text(), ::mysql_is_ordered()...) are not the removed mysql extension. -->
        <exclude name="PHPCompatibility.Extensions.RemovedExtensions.mysql_DeprecatedRemoved"/>
        <!-- Private methods named __full_build(), __statistics()...: a naming choice, not a magic method. -->
        <exclude name="PHPCompatibility.FunctionNameRestrictions.ReservedFunctionNames.MethodDoubleUnderscore"/>
    </rule>
</ruleset>
